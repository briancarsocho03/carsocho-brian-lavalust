# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# LavaLust API token signing keys (use separate random values, at least 32 chars)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Comma-separated allowed frontend origins (no trailing slash); may include localhost for local development
FRONTEND_URL=
